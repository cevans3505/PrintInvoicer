<Application x:Class="PrintInvoicer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PrintInvoicer.App"
             ThemeMode="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Fluent dark styles for every control; the implicit styles below are based on them. -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <local:BytesToImageConverter x:Key="BytesToImage" />
            <local:HexToBrushConverter x:Key="HexToBrush" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />

            <SolidColorBrush x:Key="WindowBg" Color="#1B1E22" />
            <SolidColorBrush x:Key="CardBg" Color="#24282E" />
            <SolidColorBrush x:Key="CardBorder" Color="#383E46" />
            <SolidColorBrush x:Key="Divider" Color="#30353C" />
            <SolidColorBrush x:Key="Text" Color="#E6E8EB" />
            <SolidColorBrush x:Key="Accent" Color="#4C9BE8" />
            <SolidColorBrush x:Key="Muted" Color="#9AA3AD" />
            <SolidColorBrush x:Key="Warn" Color="#F0A35A" />
            <SolidColorBrush x:Key="Override" Color="#4D3F1C" />
            <!-- Plate thumbnails are dark parts on a transparent background, so they sit on a light tile. -->
            <SolidColorBrush x:Key="ThumbBg" Color="#D9DDE2" />

            <!-- Based on Fluent's named styles; {x:Type ...} would resolve to the classic theme here. -->
            <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="70" />
            </Style>
            <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <!-- Fluent's disabled box looks almost the same as an editable one; dim it so a locked job reads as locked. -->
                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.55" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style TargetType="Label" BasedOn="{StaticResource DefaultLabelStyle}" />
            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="MinWidth" Value="70" />
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="#0E1116" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Accent}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Padding" Value="4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                <TextBlock x:Name="Label" Text="{TemplateBinding Content}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Label" Property="TextDecorations" Value="Underline" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Muted}" />
                                    <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,12,0,6" />
            </Style>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BorderBrush" Value="{StaticResource CardBorder}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="{StaticResource CardBg}" />
                <Setter Property="Padding" Value="12" />
                <Setter Property="Margin" Value="0,0,0,10" />
            </Style>
            <Style x:Key="Swatch" TargetType="Border">
                <Setter Property="Width" Value="16" />
                <Setter Property="Height" Value="16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderBrush" Value="#8A929C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
