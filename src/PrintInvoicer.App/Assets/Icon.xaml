<!-- PrintInvoicer icon, concept A "printed invoice", on a 256 x 256 canvas.
     Source for PrintInvoicer.ico; regenerate with tools\Make-Icon.ps1 after editing.
     Small sizes (24 px and under) use the simplified drawing below it, since thin text lines blur together there. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DrawingGroup x:Key="Full">
        <GeometryDrawing Brush="#1F6FB2"><GeometryDrawing.Geometry><RectangleGeometry Rect="8,8,240,240" RadiusX="52" RadiusY="52" /></GeometryDrawing.Geometry></GeometryDrawing>
        <!-- hotend and nozzle -->
        <GeometryDrawing Brush="#E6E8EB"><GeometryDrawing.Geometry><RectangleGeometry Rect="96,22,64,30" RadiusX="6" RadiusY="6" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#F0A35A" Geometry="M110,52 L146,52 L136,72 L120,72 Z" />
        <GeometryDrawing Brush="#F0A35A"><GeometryDrawing.Geometry><RectangleGeometry Rect="123,72,10,40" /></GeometryDrawing.Geometry></GeometryDrawing>
        <!-- invoice page -->
        <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="52,92,152,140" RadiusX="14" RadiusY="14" /></GeometryDrawing.Geometry></GeometryDrawing>
        <!-- the line being printed, then text lines and the total -->
        <GeometryDrawing Brush="#F0A35A"><GeometryDrawing.Geometry><RectangleGeometry Rect="76,110,57,14" RadiusX="7" RadiusY="7" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#C3CEDB"><GeometryDrawing.Geometry><RectangleGeometry Rect="76,138,104,12" RadiusX="6" RadiusY="6" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#C3CEDB"><GeometryDrawing.Geometry><RectangleGeometry Rect="76,162,104,12" RadiusX="6" RadiusY="6" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#C3CEDB"><GeometryDrawing.Geometry><RectangleGeometry Rect="76,186,56,12" RadiusX="6" RadiusY="6" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#1F6FB2"><GeometryDrawing.Geometry><RectangleGeometry Rect="140,204,40,14" RadiusX="7" RadiusY="7" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup>

    <DrawingGroup x:Key="Small">
        <!-- Coordinates are multiples of 16 so every edge lands on a whole pixel at 16 px. -->
        <GeometryDrawing Brush="#1F6FB2"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,256,256" RadiusX="48" RadiusY="48" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#E6E8EB"><GeometryDrawing.Geometry><RectangleGeometry Rect="80,16,96,32" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#F0A35A" Geometry="M96,48 L160,48 L144,80 L112,80 Z" />
        <GeometryDrawing Brush="#F0A35A"><GeometryDrawing.Geometry><RectangleGeometry Rect="112,80,32,48" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#FFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="32,96,192,144" RadiusX="16" RadiusY="16" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#F0A35A"><GeometryDrawing.Geometry><RectangleGeometry Rect="64,112,80,32" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Brush="#9FB0C4"><GeometryDrawing.Geometry><RectangleGeometry Rect="64,176,128,32" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingGroup>
</ResourceDictionary>
