<Window x:Class="PrintInvoicer.App.JobEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Icon="pack://application:,,,/PrintInvoicer;component/Assets/PrintInvoicer.ico" Height="820" Width="1320" MinWidth="980" MinHeight="560"
        Background="{StaticResource WindowBg}" WindowStartupLocation="CenterOwner" AllowDrop="True" Drop="Window_Drop"
        DragOver="Window_DragOver" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="OverrideBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="ToolTip" Value="Type a value to override the slicer estimate" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="12">
        <!-- Job header -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
            <Grid>
                <Grid.Resources>
                    <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="0,0,10,0" />
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label Content="Job" />
                <TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="14" Margin="0,2,12,2" IsEnabled="{Binding IsEditable}" />
                <Label Grid.Column="2" Content="Customer" />
                <TextBox Grid.Column="3" Text="{Binding Customer}" Margin="0,2,12,2" IsEnabled="{Binding IsEditable}" />
                <Label Grid.Column="4" Content="Invoice #" />
                <TextBox Grid.Column="5" Text="{Binding InvoiceNumber}" Width="130" Margin="0,2,12,2" IsEnabled="{Binding IsEditable}"
                         ToolTip="Reserved when the job is created. Type a number to set it yourself." />
                <Label Grid.Row="1" Grid.Column="4" Content="Invoice date" />
                <DatePicker Grid.Row="1" Grid.Column="5" SelectedDate="{Binding InvoiceDate}" Width="130" Margin="0,2,12,2"
                            ToolTip="Set to today when you finalize the invoice. Change it here only to correct a finalized date." />
                <CheckBox Grid.Column="6" Content="Printed" IsChecked="{Binding Printed}" VerticalAlignment="Center"
                          ToolTip="Tick when every plate for this job is printed" />
                <CheckBox Grid.Row="1" Grid.Column="6" Content="Paid" IsChecked="{Binding Paid}" VerticalAlignment="Center" />
                <StackPanel Grid.Column="7" Grid.RowSpan="2" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="150">
                    <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                    <TextBlock Text="Locked at the prices it was sent with" Style="{StaticResource Small}"
                               Visibility="{Binding IsFinalized, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Revert to draft" Command="{Binding RevertToDraftCommand}" Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Left" Padding="0,2,0,0"
                            Visibility="{Binding IsFinalized, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Label Grid.Row="1" Content="Notes" />
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}" Margin="0,2,12,2" IsEnabled="{Binding IsEditable}"
                         ToolTip="Printed on the invoice under the line items" />
            </Grid>
        </Border>

        <!-- Buttons -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Content="Add sliced files..." Command="{Binding AddFilesCommand}" IsEnabled="{Binding IsEditable}" />
            <Button DockPanel.Dock="Left" Content="Add plate by hand..." Click="ManualPlate_Click" IsEnabled="{Binding IsEditable}"
                    ToolTip="For slicers whose files are not read automatically: pick the printer, then type the print time and material">
                <Button.ContextMenu>
                    <ContextMenu ItemsSource="{Binding ManualPlateChoices}">
                        <ContextMenu.ItemContainerStyle>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Label}" />
                                <Setter Property="Command" Value="{Binding DataContext.AddManualPlateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </ContextMenu.ItemContainerStyle>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Small}" Text="or drag .gcode.3mf or .goo files onto this window" />
            <Button DockPanel.Dock="Right" Content="Close" Click="Close_Click" Margin="0" />
            <Button DockPanel.Dock="Right" Content="Save" Command="{Binding SaveCommand}" />
            <Button DockPanel.Dock="Right" Content="Detail PDF (internal)" Command="{Binding CreateDetailCommand}"
                    ToolTip="Full breakdown with grams, hours and rates, for your records" />
            <Button DockPanel.Dock="Right" Content="Finalize invoice" Command="{Binding FinalizeInvoiceCommand}"
                    Style="{StaticResource AccentButton}"
                    ToolTip="Date the invoice today and make the PDF to send to the customer" />
            <Button DockPanel.Dock="Right" Content="Preview invoice" Command="{Binding PreviewInvoiceCommand}"
                    ToolTip="See the invoice as it stands, without dating or finalizing it" />
        </DockPanel>

        <!-- Summary -->
        <Border DockPanel.Dock="Right" Width="310" Style="{StaticResource Card}" Margin="10,0,0,0" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Labor" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                <StackPanel IsEnabled="{Binding IsEditable}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="3D modeling hours" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Text="{Binding ModelingHours}" Width="60" />
                    <TextBlock Text="{Binding ModelingRateText}" Style="{StaticResource Small}" Margin="6,0,0,0" />
                </StackPanel>
                <CheckBox Content="{Binding PostProcessingText}" IsChecked="{Binding PostProcessing}" Margin="0,8,0,0" />

                <StackPanel Visibility="{Binding HasExtraCosts, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Extra costs" Style="{StaticResource SectionHeader}" />
                    <ItemsControl ItemsSource="{Binding ExtraCosts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Included}" Margin="0,0,0,4" ToolTip="Untick to leave this off this job only">
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                </StackPanel>

                <TextBlock Text="Totals" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Material" Style="{StaticResource Small}" ToolTip="Includes each printer's waste allowance and markup on your own material" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MaterialText}" Style="{StaticResource Small}" />
                    <TextBlock Grid.Row="1" Text="Machine time" Style="{StaticResource Small}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MachineText}" Style="{StaticResource Small}" />
                    <TextBlock Grid.Row="2" Text="Electricity" Style="{StaticResource Small}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ElectricityText}" Style="{StaticResource Small}" />
                    <TextBlock Grid.Row="3" Text="Extra costs on prints" Style="{StaticResource Small}"
                               Visibility="{Binding HasPlateExtras, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding PlateExtrasText}" Style="{StaticResource Small}"
                               Visibility="{Binding HasPlateExtras, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Row="4" Text="Printed parts (billed)" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PartsText}" Margin="0,4,0,0" />
                    <TextBlock Grid.Row="5" Text="{Binding SlicingLabel}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SlicingText}" />
                    <TextBlock Grid.Row="6" Text="3D modeling" />
                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding ModelingText}" />
                    <TextBlock Grid.Row="7" Text="Post-processing" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PostText}" />
                    <TextBlock Grid.Row="8" Text="Per-job extra costs" Visibility="{Binding HasJobExtras, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding JobExtrasText}" Visibility="{Binding HasJobExtras, Converter={StaticResource BoolToVis}}" />
                    <Separator Grid.Row="9" Grid.ColumnSpan="2" Margin="0,6" />
                    <TextBlock Grid.Row="10" Text="Total" FontSize="16" FontWeight="Bold" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding TotalText}" FontSize="16" FontWeight="Bold" />
                </Grid>

                <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="{StaticResource Warn}" TextWrapping="Wrap" Margin="0,0,0,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Parts -->
        <Grid>
            <TextBlock Text="Drag sliced .gcode.3mf or .goo files here, or use Add sliced files or Add plate by hand." FontSize="16"
                       Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       x:Name="EmptyHint" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Parts}" IsEnabled="{Binding IsEditable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Remove part" Command="{Binding RemoveCommand}" Style="{StaticResource LinkButton}" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0" />
                                        <CheckBox DockPanel.Dock="Right" Content="Slicing fee" IsChecked="{Binding ChargeSlicing}" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" BorderThickness="0,0,0,1" Margin="0,0,12,0"
                                                 ToolTip="Part name shown on the invoice. Rename it to match another part to merge them when you save." />
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Plates}" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{StaticResource Divider}" BorderThickness="0,1,0,0" Padding="0,8,0,4">
                                                    <DockPanel>
                                                        <Border DockPanel.Dock="Left" Background="{StaticResource ThumbBg}" CornerRadius="6" Padding="4"
                                                                Margin="0,0,12,0" VerticalAlignment="Top"
                                                                Visibility="{Binding HasThumbnail, Converter={StaticResource BoolToVis}}">
                                                            <Image Width="92" Height="92" Source="{Binding Thumbnail, Converter={StaticResource BytesToImage}}" />
                                                        </Border>
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Button DockPanel.Dock="Right" Content="Remove plate" Command="{Binding RemoveCommand}" Style="{StaticResource LinkButton}" />
                                                                <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding PrinterOptions}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                                                          SelectedValue="{Binding PrinterId}" MinWidth="190" Margin="12,0,12,0"
                                                                          ToolTip="Printer this plate is printed on; its rates are used" />
                                                                <TextBlock DockPanel.Dock="Right" Text="Printer" Style="{StaticResource Small}" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding LayerText}" Style="{StaticResource Small}" Margin="12,0,16,0" />
                                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" ToolTip="{Binding SourceFile}" VerticalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis" />
                                                            </DockPanel>
                                                            <WrapPanel Margin="0,6,0,0">
                                                                <TextBlock Text="Print" VerticalAlignment="Center" />
                                                                <TextBox Text="{Binding Copies}" Width="40" Margin="6,0" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="time(s), with" VerticalAlignment="Center" />
                                                                <TextBox Text="{Binding PartsPerPlate}" Width="40" Margin="6,0" HorizontalContentAlignment="Center" />
                                                                <TextBlock Text="parts on the plate.   Print time" VerticalAlignment="Center" />
                                                                <TextBox Text="{Binding TimeText}" Width="60" Margin="6,0" HorizontalContentAlignment="Center">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource OverrideBox}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsTimeOverridden}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource Override}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock Text="{Binding SlicedTimeText}" Style="{StaticResource Small}" />
                                                                <Button Content="reset" Command="{Binding ResetTimeCommand}" Style="{StaticResource LinkButton}"
                                                                        Visibility="{Binding IsTimeOverridden, Converter={StaticResource BoolToVis}}" />
                                                            </WrapPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                                                        Visibility="{Binding IsCountUnconfirmed, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Resin files do not record how many parts are on the plate. Set it above, or confirm"
                                                                           Foreground="{StaticResource Warn}" VerticalAlignment="Center" />
                                                                <Button Content="the count is right" Command="{Binding ConfirmCountCommand}" Style="{StaticResource LinkButton}" />
                                                            </StackPanel>

                                                            <!-- Resin plates: one resin for the vat. Columns match the slot rows below. -->
                                                            <Grid Margin="0,8,0,0" Visibility="{Binding IsResin, Converter={StaticResource BoolToVis}}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="78" />
                                                                    <ColumnDefinition Width="*" MinWidth="90" MaxWidth="280" />
                                                                    <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="460" />
                                                                    <ColumnDefinition Width="74" />
                                                                    <ColumnDefinition Width="30" />
                                                                    <ColumnDefinition Width="44" />
                                                                    <ColumnDefinition Width="150" />
                                                                    <ColumnDefinition Width="*" MinWidth="56" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="Resin" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ResinProfileLabel}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding ResinProfileLabel}" Margin="0,0,8,0" />
                                                                <ComboBox Grid.Column="2" ItemsSource="{Binding ResinOptions}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                                                          SelectedValue="{Binding ResinId}" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                                                <TextBox Grid.Column="3" Text="{Binding Ml, StringFormat=0.##}" HorizontalContentAlignment="Right"
                                                                         ToolTip="Resin per print. Type a measured amount to override the slicer estimate">
                                                                    <TextBox.Style>
                                                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsMlOverridden}" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource Override}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBox.Style>
                                                                </TextBox>
                                                                <TextBlock Grid.Column="4" Text="mL" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                                <Button Grid.Column="5" Content="reset" Command="{Binding ResetMlCommand}" Style="{StaticResource LinkButton}"
                                                                        ToolTip="{Binding SlicedMlText}" HorizontalAlignment="Left"
                                                                        Visibility="{Binding IsMlOverridden, Converter={StaticResource BoolToVis}}" />
                                                                <CheckBox Grid.Column="6" Content="Customer supplied" IsChecked="{Binding ResinCustomerSupplied}" VerticalAlignment="Center" />
                                                                <TextBlock Grid.Column="7" Text="{Binding ResinCostText}" ToolTip="{Binding ResinCostTip}" Style="{StaticResource Small}" />
                                                            </Grid>

                                                            <ItemsControl ItemsSource="{Binding Slots}" Margin="0,8,0,0"
                                                                          Visibility="{Binding IsFdm, Converter={StaticResource BoolToVis}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <!-- Profile, filament and cost columns are star-sized so the row grows with the window.
                                                                             Every other column has a fixed width so the columns line up from row to row. -->
                                                                        <Grid Margin="0,2">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="22" />
                                                                                <ColumnDefinition Width="56" />
                                                                                <ColumnDefinition Width="*" MinWidth="90" MaxWidth="280" />
                                                                                <ColumnDefinition Width="2*" MinWidth="170" MaxWidth="460" />
                                                                                <ColumnDefinition Width="74" />
                                                                                <ColumnDefinition Width="30" />
                                                                                <ColumnDefinition Width="44" />
                                                                                <ColumnDefinition Width="150" />
                                                                                <ColumnDefinition Width="*" MinWidth="56" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Border Style="{StaticResource Swatch}" Background="{Binding ColorHex, Converter={StaticResource HexToBrush}}" HorizontalAlignment="Left" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding SlotLabel}" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding SlicerLabel}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding SlicerLabel}" Margin="0,0,8,0" />
                                                                            <ComboBox Grid.Column="3" ItemsSource="{Binding FilamentOptions}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"
                                                                                      SelectedValue="{Binding FilamentId}" HorizontalAlignment="Stretch" Margin="0,0,8,0" />
                                                                            <TextBox Grid.Column="4" Text="{Binding Grams, StringFormat=0.##}" HorizontalContentAlignment="Right">
                                                                                <TextBox.Style>
                                                                                    <Style TargetType="TextBox" BasedOn="{StaticResource OverrideBox}">
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding IsGramsOverridden}" Value="True">
                                                                                                <Setter Property="Background" Value="{StaticResource Override}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBox.Style>
                                                                            </TextBox>
                                                                            <TextBlock Grid.Column="5" Text="g" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="6" Content="reset" Command="{Binding ResetGramsCommand}" Style="{StaticResource LinkButton}"
                                                                                    ToolTip="{Binding SlicedGramsText}" HorizontalAlignment="Left"
                                                                                    Visibility="{Binding IsGramsOverridden, Converter={StaticResource BoolToVis}}" />
                                                                            <CheckBox Grid.Column="7" Content="Customer supplied" IsChecked="{Binding CustomerSupplied}" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="8" Text="{Binding CostText}" ToolTip="{Binding CostTip}" Style="{StaticResource Small}" />
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <TextBlock Text="{Binding CostText}" Style="{StaticResource Small}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                                            <!-- Failed objects: recorded and shown on both PDFs; billing is unchanged. -->
                                                            <Grid Margin="0,8,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <CheckBox Content="Print failures" IsChecked="{Binding HasFailures}" VerticalAlignment="Center"
                                                                          ToolTip="Tick if any objects on this plate failed to print" Margin="0,0,14,0" />
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,14,0"
                                                                            Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                                                                    <TextBox Text="{Binding FailedCount}" Width="50" HorizontalContentAlignment="Center" />
                                                                    <TextBlock Text="{Binding FailedOfText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                </StackPanel>
                                                                <DockPanel Grid.Column="2" Visibility="{Binding HasFailures, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="Note" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                    <TextBox Text="{Binding FailureNote}" ToolTip="What went wrong, e.g. broke free from the print bed" />
                                                                </DockPanel>
                                                            </Grid>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
